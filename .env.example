
# ================================
# SUPABASE CONFIGURATION
# ================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ================================
# EMAIL CONFIGURATION (RESEND)
# ================================
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM=noreply@studentverse.ae

# ================================
# JWT CONFIGURATION
# ================================
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256

# ================================
# OPENROUTER CONFIGURATION
# ================================
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
ORBIT_MAX_RESULTS=10

# Orbit Chat Rate Limiting
DAILY_CHAT_LIMIT=150

# ================================
# APPLICATION SETTINGS
# ================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_VERSION=v1

# ================================
# FEATURE FLAGS
# ================================
FEATURE_SV_PAY_ENABLED=false
FEATURE_SV_ORBIT_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_PAYMENT_PER_MIN=20
RATE_LIMIT_PROXY_HOPS=1

# ================================
# EMAIL VALIDATION
# ================================
ALLOWED_EMAIL_DOMAINS=student.university.edu,edu.university.ae

# ================================
# RAILWAY DEPLOYMENT
# ================================
PORT=8000

# ================================
# INTERNAL NOTIFICATIONS
# ================================
INTERNAL_BOOKINGS_EMAIL=
